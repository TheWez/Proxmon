/* styles.css */
DataTable {
    border: round magenta;
    max-height: 25vh;
    background: black 100%;
    
}

#gpu_charts_vs{
    height: auto;
    max-height: 40vh;
    display: none; /* shown once a GPU is detected */
}

#topbar_container{
    height:auto;
    max-height:6;
    text-align: justify;
}

#vm_table_vs{
    height: auto;
    max-height: 25vh;
}

#topbar{
    height:auto;
    min-height: 3;
    max-height: 6;
    border: round magenta;
}

ToastRack {
    align: right top;
}

Toast {
    padding: 2;
}

ConfirmScreen {
    align: center middle;
}

#confirm_box {
    width: 60;
    height: auto;
    padding: 1 2;
    border: thick $error;
    background: $surface;
}

#confirm_buttons {
    height: auto;
    margin-top: 1;
    align: center middle;
}

#confirm_buttons Button {
    margin: 0 2;
}
