/* styles.css */
DataTable {
    border: round magenta;
    max-height: 25vh;
    background: black 100%;
    
}

#gpu_charts_vs{
    height: auto;
    max-height: 40vh;
    display: none; /* shown once a GPU is detected */
}

#topbar_container{
    height:auto;
    max-height:6;
    text-align: justify;
}

#vm_table_vs{
    height: auto;
    max-height: 25vh;
}

#topbar{
    height:auto;
    min-height: 3;
    max-height: 6;
    border: round magenta;
}

ToastRack {
    align: right top;
}

Toast {
    padding: 2;
}